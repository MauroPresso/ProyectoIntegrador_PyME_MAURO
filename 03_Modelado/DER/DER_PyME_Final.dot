digraph DER {
graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0, bgcolor="white", fontname="DejaVu Sans", label="DER - Sistema de Ventas y Facturacion para PyME Generica", labelloc=t, fontsize=24];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=11, color="#333333", arrowsize=0.8];
PROVINCIAS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>PROVINCIAS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_provincia INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre VARCHAR(100)</FONT></TD></TR></TABLE>>];
LOCALIDADES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>LOCALIDADES</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_localidad INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_provincia INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">codigo_postal VARCHAR(20)</FONT></TD></TR></TABLE>>];
TIPOS_CLIENTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>TIPOS_CLIENTE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_tipo_cliente INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tipo VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion VARCHAR(150)</FONT></TD></TR></TABLE>>];
CLIENTES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>CLIENTES</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_cliente INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_localidad INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_tipo_cliente INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tipo_persona CHAR(1)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">cuil_cuit VARCHAR(11)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre_razon_social VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">direccion VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">telefono VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">email VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">activo BIT</FONT></TD></TR></TABLE>>];
ROLES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>ROLES</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_rol INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">rol VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion VARCHAR(150)</FONT></TD></TR></TABLE>>];
USUARIOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>USUARIOS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_usuario INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_rol INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre_usuario VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">clave_hash VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre_completo VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">email VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">activo BIT</FONT></TD></TR></TABLE>>];
CATEGORIAS_PRODUCTO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>CATEGORIAS_PRODUCTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_categoria INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">activo BIT</FONT></TD></TR></TABLE>>];
IMPUESTOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>IMPUESTOS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_impuesto INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">impuesto VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">porcentaje DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">activo BIT</FONT></TD></TR></TABLE>>];
PRODUCTOS_SERVICIOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>PRODUCTOS_SERVICIOS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_producto_servicio INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_categoria INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_impuesto INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion VARCHAR(250)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">precio_unitario_actual DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">activo BIT</FONT></TD></TR></TABLE>>];
ESTADOS_FACTURA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>ESTADOS_FACTURA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_estado_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estado VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion VARCHAR(150)</FONT></TD></TR></TABLE>>];
TIPOS_FACTURA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>TIPOS_FACTURA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_tipo_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tipo VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion VARCHAR(150)</FONT></TD></TR></TABLE>>];
TIPOS_OPERACION_FACTURA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>TIPOS_OPERACION_FACTURA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_tipo_operacion_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">operacion VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion VARCHAR(150)</FONT></TD></TR></TABLE>>];
FACTURAS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>FACTURAS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_cliente INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_usuario INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_estado_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_tipo_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_tipo_operacion_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">numero_factura VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_emision DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">total_neto DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">total_impuestos DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">total_descuentos DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">total_recargos DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">total DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">observaciones VARCHAR(250)</FONT></TD></TR></TABLE>>];
DETALLES_FACTURA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>DETALLES_FACTURA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_detalle_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_producto_servicio INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_impuesto INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">cantidad DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">precio_unitario_facturado DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">subtotal_neto DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">porcentaje_impuesto_facturado DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">importe_impuesto DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">subtotal_con_impuesto DECIMAL(12,2)</FONT></TD></TR></TABLE>>];
FORMAS_PAGO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>FORMAS_PAGO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_forma_pago INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">forma_pago VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion VARCHAR(150)</FONT></TD></TR></TABLE>>];
COMPROBANTES_PAGO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>COMPROBANTES_PAGO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_comprobante_pago INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_factura INT UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_forma_pago INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_pago DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">monto DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">numero_referencia VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">observaciones VARCHAR(150)</FONT></TD></TR></TABLE>>];
DESCUENTOS_FACTURA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>DESCUENTOS_FACTURA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_descuento_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">porcentaje DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">monto DECIMAL(12,2)</FONT></TD></TR></TABLE>>];
RECARGOS_FACTURA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEEFF"><B>RECARGOS_FACTURA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK id_recargo_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_factura INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">porcentaje DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">monto DECIMAL(12,2)</FONT></TD></TR></TABLE>>];
PROVINCIAS -> LOCALIDADES [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
LOCALIDADES -> CLIENTES [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
TIPOS_CLIENTE -> CLIENTES [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
ROLES -> USUARIOS [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
USUARIOS -> FACTURAS [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
CLIENTES -> FACTURAS [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
ESTADOS_FACTURA -> FACTURAS [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
TIPOS_FACTURA -> FACTURAS [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
TIPOS_OPERACION_FACTURA -> FACTURAS [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
FACTURAS -> DETALLES_FACTURA [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
PRODUCTOS_SERVICIOS -> DETALLES_FACTURA [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
IMPUESTOS -> DETALLES_FACTURA [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
CATEGORIAS_PRODUCTO -> PRODUCTOS_SERVICIOS [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
IMPUESTOS -> PRODUCTOS_SERVICIOS [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
FACTURAS -> COMPROBANTES_PAGO [taillabel="1", headlabel="1", labeldistance=1.7, labelangle=25, arrowhead=none];
FORMAS_PAGO -> COMPROBANTES_PAGO [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
FACTURAS -> DESCUENTOS_FACTURA [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
FACTURAS -> RECARGOS_FACTURA [taillabel="1", headlabel="N", labeldistance=1.7, labelangle=25, arrowhead=none];
NOTAS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF2CC"><B>Notas</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">cuil_cuit VARCHAR(11), sin guiones</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tipo_persona: F o J</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">COMPROBANTES_PAGO.id_factura UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">total = neto + impuestos + recargos - descuentos</FONT></TD></TR></TABLE>>];
}